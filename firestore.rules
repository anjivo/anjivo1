rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // COMMON HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return userExists()
        && currentUser().data.role in [
          "ADMIN",
          "SUPERADMIN",
          "admin",
          "superadmin"
        ]
        && currentUser().data.accountStatus != "BLOCKED"
        && currentUser().data.accountStatus != "blocked";
    }

    function isSeller() {
      return userExists()
        && currentUser().data.role == "SELLER"
        && currentUser().data.accountStatus == "ACTIVE";
    }

    function isCustomer() {
      return userExists()
        && (
          currentUser().data.role == "RETAIL_CUSTOMER"
          || currentUser().data.role == "WHOLESALE_CUSTOMER"
        )
        && currentUser().data.accountStatus == "ACTIVE";
    }

    function isWholesaleCustomer() {
      return userExists()
        && currentUser().data.role == "WHOLESALE_CUSTOMER"
        && currentUser().data.accountStatus == "ACTIVE";
    }

    function sellerDocExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/sellers/$(request.auth.uid)
        );
    }

    function isApprovedSeller() {
      return userExists()
        && currentUser().data.role == "SELLER"
        && currentUser().data.accountStatus == "ACTIVE"
        && sellerDocExists()
        && get(
          /databases/$(database)/documents/sellers/$(request.auth.uid)
        ).data.status == "approved"
        && get(
          /databases/$(database)/documents/sellers/$(request.auth.uid)
        ).data.adminApproved == true;
    }

    function sellerOwns(sellerId) {
      return isApprovedSeller()
        && sellerId == request.auth.uid;
    }

    function orderExists(orderId) {
      return exists(
        /databases/$(database)/documents/orders/$(orderId)
      );
    }

    function getOrder(orderId) {
      return get(
        /databases/$(database)/documents/orders/$(orderId)
      );
    }

    function ownsOrder(orderId) {
      return signedIn()
        && orderExists(orderId)
        && getOrder(orderId).data.userId == request.auth.uid;
    }

    function sellerInOrder(orderId) {
      return isApprovedSeller()
        && orderExists(orderId)
        && request.auth.uid in getOrder(orderId).data.sellerIds;
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if isOwner(userId)
        || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in [
          "RETAIL_CUSTOMER",
          "WHOLESALE_CUSTOMER"
        ]
        && request.resource.data.accountStatus == "PENDING_VERIFICATION";

      allow update: if isAdmin()
        || (
          isOwner(userId)

          && request.resource.data.uid
             == resource.data.uid

          && request.resource.data.role
             == resource.data.role

          && request.resource.data.accountStatus
             == resource.data.accountStatus

          && request.resource.data.sellerApplicationStatus
             == resource.data.sellerApplicationStatus

          && request.resource.data.emailVerified
             == resource.data.emailVerified

          && request.resource.data.phoneVerified
             == resource.data.phoneVerified
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLERS
    // =========================================================

    match /sellers/{sellerId} {

      // Full seller/KYC document is NOT public.
      allow read: if isAdmin()
        || isOwner(sellerId);

      allow create: if isOwner(sellerId)
        && request.resource.data.userId
           == request.auth.uid

        && request.resource.data.status
           == "pending"

        && request.resource.data.sellerVerified
           == false

        && request.resource.data.adminApproved
           == false

        && request.resource.data.emailVerified
           == false

        && request.resource.data.phoneVerified
           == false

        && request.resource.data.gstVerified
           == false

        && request.resource.data.panVerified
           == false

        && request.resource.data.bankVerified
           == false

        && request.resource.data.accountStatus
           == "PENDING";

      allow update: if isAdmin()
        || (
          isOwner(sellerId)

          && resource.data.status == "pending"

          && request.resource.data.userId
             == resource.data.userId

          && request.resource.data.status
             == resource.data.status

          && request.resource.data.sellerVerified
             == resource.data.sellerVerified

          && request.resource.data.adminApproved
             == resource.data.adminApproved

          && request.resource.data.emailVerified
             == resource.data.emailVerified

          && request.resource.data.phoneVerified
             == resource.data.phoneVerified

          && request.resource.data.gstVerified
             == resource.data.gstVerified

          && request.resource.data.panVerified
             == resource.data.panVerified

          && request.resource.data.bankVerified
             == resource.data.bankVerified

          && request.resource.data.accountStatus
             == resource.data.accountStatus
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PUBLIC SELLER PROFILES
    // =========================================================
    // Keep public-safe information separate from seller KYC.

    match /sellerPublicProfiles/{sellerId} {

      allow read: if resource.data.status == "active"
        || isAdmin()
        || isOwner(sellerId);

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      allow read: if resource.data.status == "active"
        || isAdmin()
        || (
          signedIn()
          && resource.data.sellerId == request.auth.uid
        );

     allow create: if (
    isAdmin()
    && request.resource.data.sellerId == request.auth.uid
    && request.resource.data.sellerName == "ANJIVO Official"
    && request.resource.data.sellerVerified == true
    && request.resource.data.status in ["active", "draft"]
  )
  || (
    isApprovedSeller()
    && request.resource.data.sellerId == request.auth.uid
    && request.resource.data.status == "draft"
  );

      allow update: if isAdmin()
        || (
          sellerOwns(
            resource.data.sellerId
          )

          && request.resource.data.sellerId
             == resource.data.sellerId

          && request.resource.data.status
             == resource.data.status
        );

      allow delete: if isAdmin()
        || (
          sellerOwns(
            resource.data.sellerId
          )
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{categoryId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SUBCATEGORIES
    // =========================================================

    match /subcategories/{subcategoryId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // BRANDS
    // =========================================================

    match /brands/{brandId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CARTS
    // =========================================================

    match /carts/{userId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // WISHLISTS
    // =========================================================

    match /wishlists/{userId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // ADDRESSES
    // =========================================================

    match /addresses/{userId}/items/{addressId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      allow read: if isAdmin()
        || ownsOrder(orderId)
        || sellerInOrder(orderId);

      /*
       * Orders must be created through the trusted backend
       * app/api/orders/create route. Admin SDK writes bypass
       * Firestore client rules; browser clients cannot create orders.
       */
      allow create: if false;

      /*
       * Order status, assignment, prices, totals, payment fields,
       * addresses and fulfillment metadata are sensitive.
       * Only admins may update orders directly from a client.
       * Seller and delivery workflows should use authenticated
       * backend routes that validate the caller and allowed transition.
       */
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // ORDER ITEMS
    // =========================================================

    match /orders/{orderId}/items/{itemId} {

      allow read: if isAdmin()
        || ownsOrder(orderId)
        || sellerInOrder(orderId);

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // REVIEWS
    // =========================================================

    match /reviews/{reviewId} {

      allow read: if isAdmin()
        || resource.data.status == "approved"
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if isCustomer()
        && request.resource.data.userId
           == request.auth.uid
        && request.resource.data.status
           == "pending";

      allow update: if isAdmin()
        || (
          isCustomer()

          && resource.data.userId
             == request.auth.uid

          && resource.data.status
             == "pending"

          && request.resource.data.status
             == "pending"
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // WHOLESALE QUOTES
    // =========================================================

    match /wholesaleQuotes/{quoteId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.buyerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isWholesaleCustomer()
        && request.resource.data.buyerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.buyerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // WHOLESALE ENQUIRIES
    // =========================================================

    match /wholesaleEnquiries/{enquiryId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isWholesaleCustomer()
        && request.resource.data.customerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER OFFERS
    // =========================================================

    match /sellerOffers/{offerId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "active"
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
          && request.resource.data.sellerId
             == resource.data.sellerId
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // PRODUCT QUESTIONS
    // =========================================================

    match /productQuestions/{questionId} {

      allow read: if true;

      allow create: if isCustomer()
        && request.resource.data.userId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );
    }


    // =========================================================
    // PRODUCT ANSWERS
    // =========================================================

    match /productAnswers/{answerId} {

      allow read: if true;

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
          && request.resource.data.sellerId
             == resource.data.sellerId
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // COUPONS
    // =========================================================

    match /coupons/{couponId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.status == "active"
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PROMOTIONS
    // =========================================================

    match /promotions/{promotionId} {

      allow read: if isAdmin()
        || (
          resource.data.status == "active"
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // BANNERS
    // =========================================================

    match /banners/{bannerId} {

      allow read: if isAdmin()
        || resource.data.status == "active";

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // TRANSACTIONS
    // =========================================================
    // Financial records.
    // Client/customer/seller cannot modify them.

    match /transactions/{transactionId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PAYMENT TRANSACTIONS
    // =========================================================

    match /paymentTransactions/{transactionId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // REFUND TRANSACTIONS
    // =========================================================

    match /refundTransactions/{refundId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SETTLEMENTS
    // =========================================================

    match /settlements/{settlementId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER COMMISSIONS
    // =========================================================

    match /sellerCommissions/{commissionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER PAYOUTS
    // =========================================================

    match /sellerPayouts/{payoutId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // INVENTORY
    // =========================================================

    match /inventory/{inventoryId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      /*
       * Inventory changes should ultimately be backend controlled.
       * For now only admin can directly write.
       */
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // INVENTORY MOVEMENTS
    // =========================================================

    match /inventoryMovements/{movementId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SHIPMENTS
    // =========================================================

    match /shipments/{shipmentId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SHIPPING TRACKING
    // =========================================================

    match /shippingTracking/{trackingId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // RETURNS
    // =========================================================

    match /returns/{returnId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isCustomer()
        && (
          request.resource.data.userId
            == request.auth.uid
          ||
          request.resource.data.customerId
            == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // DISPUTES
    // =========================================================

    match /disputes/{disputeId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if signedIn()
        && (
          request.resource.data.customerId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SUPPORT TICKETS
    // =========================================================

    match /supportTickets/{ticketId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.customerId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if signedIn()
        && (
          request.resource.data.userId
            == request.auth.uid
          ||
          request.resource.data.customerId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId
              == request.auth.uid
            ||
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SUPPORT MESSAGES
    // =========================================================

    match /supportTickets/{ticketId}/messages/{messageId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/supportTickets/$(ticketId)
          )
          && (
            get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.userId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.customerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.sellerId == request.auth.uid
          )
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.senderId
             == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER NOTIFICATIONS
    // =========================================================

    match /sellerNotifications/{sellerId}/items/{notificationId} {

      allow read: if isOwner(sellerId)
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMER NOTIFICATIONS
    // =========================================================

    match /customerNotifications/{userId}/items/{notificationId} {

      allow read: if isOwner(userId)
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // GENERAL NOTIFICATIONS
    // =========================================================

    match /notifications/{userId}/items/{notificationId} {

      allow read: if isOwner(userId)
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER MESSAGES / COMMUNICATION
    // =========================================================

    match /sellerConversations/{conversationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow create: if signedIn()
        && (
          request.resource.data.customerId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER CONVERSATION MESSAGES
    // =========================================================

    match /sellerConversations/{conversationId}/messages/{messageId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/sellerConversations/$(conversationId)
          )
          && (
            get(
              /databases/$(database)/documents/sellerConversations/$(conversationId)
            ).data.customerId
              == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/sellerConversations/$(conversationId)
            ).data.sellerId
              == request.auth.uid
          )
        );

      allow create: if signedIn()
        && request.resource.data.senderId
           == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // WISHLIST ITEMS
    // =========================================================

    match /wishlists/{userId}/items/{itemId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // SAVED SEARCHES
    // =========================================================

    match /savedSearches/{userId}/items/{searchId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // RECENTLY VIEWED
    // =========================================================

    match /recentlyViewed/{userId}/items/{itemId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // PRODUCT REPORTS
    // =========================================================

    match /productReports/{reportId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER REPORTS
    // =========================================================

    match /sellerReports/{reportId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // FRAUD / RISK FLAGS
    // =========================================================

    match /riskFlags/{riskFlagId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ADMIN NOTES
    // =========================================================

    match /adminNotes/{noteId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // PLATFORM SETTINGS
    // =========================================================

    match /settings/{settingId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FEATURE FLAGS
    // =========================================================

    match /featureFlags/{flagId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // HOMEPAGE SECTIONS
    // =========================================================

    match /homepageSections/{sectionId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // COLLECTIONS / CURATED LISTS
    // =========================================================

    match /collections/{collectionId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FLASH SALES
    // =========================================================

    match /flashSales/{flashSaleId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER VERIFICATION REQUESTS
    // =========================================================

    match /sellerVerificationRequests/{requestId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER KYC DOCUMENTS
    // =========================================================
    // Never public.

    match /sellerKycDocuments/{documentId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER BANK ACCOUNTS
    // =========================================================
    // Highly sensitive.

    match /sellerBankAccounts/{accountId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isOwner(
        request.resource.data.sellerId
      );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid

          && request.resource.data.sellerId
             == resource.data.sellerId
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMER KYC
    // =========================================================

    match /customerKyc/{kycId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMER BUSINESS PROFILES
    // =========================================================

    match /customerBusinessProfiles/{userId} {

      allow read: if isOwner(userId)
        || isAdmin();

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        || isAdmin();

      allow delete: if isAdmin()
        || isOwner(userId);
    }


    // =========================================================
    // WHOLESALE CUSTOMER VERIFICATION
    // =========================================================

    match /wholesaleCustomerVerification/{userId} {

      allow read: if isOwner(userId)
        || isAdmin();

      allow create: if isOwner(userId)
        && isWholesaleCustomer();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // VIDEO MEETINGS
    // =========================================================

    match /videoMeetings/{meetingId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow create: if signedIn()
        && (
          request.resource.data.customerId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId
              == request.auth.uid
            ||
            resource.data.sellerId
              == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PRODUCT MEDIA
    // =========================================================

    match /productMedia/{mediaId} {

      allow read: if resource.data.status == "active"
        || isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // PRODUCT VIDEOS
    // =========================================================

    match /productVideos/{videoId} {

      allow read: if resource.data.status == "active"
        || isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // AI LISTING JOBS
    // =========================================================

    match /aiListingJobs/{jobId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // AI SEARCH / VISUAL SEARCH HISTORY
    // =========================================================

    match /searchHistory/{userId}/items/{searchId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    match /visualSearches/{userId}/items/{searchId} {

      allow read, create, update, delete: if isOwner(userId)
        || isAdmin();
    }


    // =========================================================
    // SELLER ANALYTICS
    // =========================================================

    match /sellerAnalytics/{sellerId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMER ANALYTICS
    // =========================================================

    match /customerAnalytics/{userId} {

      allow read: if isAdmin()
        || isOwner(userId);

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PLATFORM ANALYTICS
    // =========================================================

    match /platformAnalytics/{reportId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // ADMIN REPORTS
    // =========================================================

    match /adminReports/{reportId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // AUDIT LOGS
    // =========================================================
    // IMPORTANT:
    // No seller/customer write access.
    // Ideally these should be generated by trusted backend.

    match /auditLogs/{logId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // ADMIN ACTIVITY
    // =========================================================

    match /adminActivity/{activityId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SECURITY EVENTS
    // =========================================================

    match /securityEvents/{eventId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // LOGIN / SESSION SECURITY
    // =========================================================

    match /securitySessions/{sessionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );
    }


    // =========================================================
    // SELLER APPLICATIONS
    // =========================================================

    match /sellerApplications/{applicationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER STAFF
    // =========================================================

    match /sellerStaff/{staffId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // SELLER STAFF ACTIVITY
    // =========================================================

    match /sellerStaffActivity/{activityId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER ORDERS / FULFILLMENT
    // =========================================================

    match /sellerFulfillment/{fulfillmentId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin()
        || (
          isApprovedSeller()
          && request.resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // COD VERIFICATION
    // =========================================================

    match /codVerifications/{verificationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create: if isCustomer()
        && request.resource.data.userId
           == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER SHIPPING PROFILES
    // =========================================================

    match /sellerShippingProfiles/{sellerId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // SELLER SERVICEABLE PINCODES
    // =========================================================

    match /sellerServiceablePincodes/{sellerId} {

      allow read: if true;

      allow create, update, delete: if isAdmin()
        || (
          isApprovedSeller()
          && sellerId == request.auth.uid
        );
    }


    // =========================================================
    // SHIPPING PARTNERS
    // =========================================================

    match /shippingPartners/{partnerId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DELIVERY AREAS
    // =========================================================

    match /deliveryAreas/{areaId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // TAX / GST CONFIGURATION
    // =========================================================

    match /taxRules/{taxRuleId} {

      allow read: if signedIn();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // COMMISSION RULES
    // =========================================================

    match /commissionRules/{ruleId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER PRICING RULES
    // =========================================================

    match /sellerPricingRules/{ruleId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin()
        || (
          isApprovedSeller()
          && request.resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // REFERRALS
    // =========================================================

    match /referrals/{referralId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.referrerId
              == request.auth.uid
            ||
            resource.data.referredUserId
              == request.auth.uid
          )
        );

      allow create: if signedIn()
        && request.resource.data.referrerId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // LOYALTY / REWARDS
    // =========================================================

    match /loyaltyAccounts/{userId} {

      allow read: if isAdmin()
        || isOwner(userId);

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // WALLET
    // =========================================================
    // Financial balance must not be client-controlled.

    match /wallets/{userId} {

      allow read: if isAdmin()
        || isOwner(userId);

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // WALLET TRANSACTIONS
    // =========================================================

    match /walletTransactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // GIFT CARDS
    // =========================================================

    match /giftCards/{giftCardId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // GIFT CARD TRANSACTIONS
    // =========================================================

    match /giftCardTransactions/{transactionId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CAMPAIGN PARTICIPATION
    // =========================================================

    match /campaignParticipants/{participantId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId
             == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if signedIn()
        && (
          request.resource.data.userId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // SELLER PROMOTION PARTICIPATION
    // =========================================================

    match /sellerPromotionParticipation/{participationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================================================
    // CONTENT / STORIES
    // =========================================================

    match /stories/{storyId} {

      allow read: if resource.data.status == "active"
        || isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if isApprovedSeller()
        && request.resource.data.sellerId
           == request.auth.uid;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );
    }


    // =========================================================
    // BLOG / GUIDES
    // =========================================================

    match /articles/{articleId} {

      allow read: if resource.data.status == "published"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FAQ
    // =========================================================

    match /faqs/{faqId} {

      allow read: if resource.data.status == "active"
        || isAdmin();

      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CONTACT / LEADS
    // =========================================================

    match /leads/{leadId} {

      allow read: if isAdmin();

      allow create: if true;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // SELLER LEADS
    // =========================================================

    match /sellerLeads/{leadId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow create: if signedIn();

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId
             == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // ADMIN DASHBOARD WIDGETS
    // =========================================================

    match /adminDashboardWidgets/{widgetId} {

      allow read, create, update, delete: if isAdmin();
    }


    // =========================================================
    // ADMIN REPORT EXPORTS
    // =========================================================

    match /reportExports/{exportId} {

      allow read: if isAdmin();

      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // EVERYTHING ELSE = DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
